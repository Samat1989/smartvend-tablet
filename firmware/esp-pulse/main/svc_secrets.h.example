// Учётка брокера сервисного открытия — ШАБЛОН.
//
// Скопируйте в svc_secrets.h (тот файл в .gitignore) и впишите реальные
// значения. Репозиторий ПУБЛИЧНЫЙ, поэтому пароль брокера сюда, в
// закоммиченный файл, писать нельзя.
//
//   cp main/svc_secrets.h.example main/svc_secrets.h
//   $EDITOR main/svc_secrets.h
//
// Учётка нужна ровно одна на весь парк и только на ЧТЕНИЕ (в HiveMQ —
// permission type «Subscribe only»). Она уезжает в прошивку, то есть
// извлекаема любым, кто вскрыл плату; важно единственное — чтобы из неё
// нельзя было опубликовать пинок на чужую машину. Учётку с правом публикации
// (svc-backend) сюда класть НЕЛЬЗЯ — она живёт в секретах Supabase.
//
// Без этого файла прошивка собирается и работает как раньше, просто не
// поднимает сервисное соединение (сборка предупредит, а плата напишет в лог
// «[svc] broker not configured»).

#pragma once

#define SVC_MQTT_USER  "svc-device"
#define SVC_MQTT_PASS  ""
