# --- Decompiled factory app ----------------------------------------------
# Reverse-engineered sources of `com.shengma.huishu.hasakesitan` (Yi-Pu-Teng).
# Useful for grep + reading, but: tens of thousands of files, copyright-
# encumbered, and easily regenerated from the original APK with jadx /
# apktool. Do NOT commit.
snack_jadx/
snack_apktool/

# --- Build / patching scratch -------------------------------------------
_patch_tmp/

# --- Binaries we can rebuild --------------------------------------------
# Signed/unsigned APKs and sidecar files. Big, can be reproduced via
# `flutter build apk` for the new app or apktool for the legacy patches.
*.apk
*.apk.idsig

# --- Signing material (NEVER commit) ------------------------------------
# Release keystore + per-environment credentials. Production releases
# are signed in CI from GitHub Secrets, locally from a dev's own copy.
*.jks
*.keystore
key.properties
**/android/key.properties

# --- Release credentials (NEVER commit) ---------------------------------
# Personal Access Token used by the release scripts. Fine-grained PAT scoped to
# `Contents: read+write` on Samat1989/smartvend-tablet. See header of
# scripts/README.md for setup instructions.
.github_token

# service_role key used by the release scripts to publish artifacts to
# Supabase Storage. Full access to the project — never commit.
.supabase_key

# Third-party tooling jars (downloaded separately when needed).
apktool*.jar
uber-apk-signer*.jar

# --- Local IDE / agent state --------------------------------------------
# Project-scope `.claude/settings.json` and `.mcp.json` ARE committed —
# they help future contributors (and the AI assistant) pick up where we
# left off. Only the personal local override is gitignored.
.claude/settings.local.json
# Lock file is runtime state, no value in source control. Use `**/`
# so it matches both `.claude/` at the root and inside `m102_tester/`.
**/.claude/scheduled_tasks.lock

# --- Python -------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# --- Node / web (apps/admin, apps/customer-qr) --------------------------
node_modules/
dist/
.vercel/

# --- Flutter / Dart build state -----------------------------------------
**/build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
**/android/local.properties
**/android/.gradle/

# --- Supabase CLI local state -------------------------------------------
**/supabase/.temp/
**/supabase/.branches/

# --- STM32CubeIDE scratch project ---------------------------------------
# Not part of the product: an STM32F103 workspace (Lesson_1) with its
# Debug/ objects, .elf/.bin and IDE metadata checked in alongside the
# sources. Left untracked on purpose — it was also what blocked the
# release script's clean-tree check until that check was narrowed to
# tracked files.
firmware/vm_12_GP/

# --- Secrets / env (NEVER commit) ---------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- OS / editors -------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Test screenshots ---------------------------------------------------
# May contain Kaspi QR codes / order ids — not safe to publish.
photo_*.jpg
photo_*.jpeg
photo_*.png

# --- Firmware flash dump (NEVER commit) ---------------------------------
# Full ESP32 flash read-back + extracted strings; large binary, contains secrets.
esp32_dump/

# --- ESP-IDF managed components (fetched by the component manager) -------
# Refetched from idf_component.yml + dependencies.lock; don't commit the copies.
**/managed_components/

# --- Provisioning QR (NEVER commit) -------------------------------------
# device-owner-qr.json/.png carry the site Wi-Fi password in clear text, and
# the QR is a working key to enrol any freshly reset tablet as device owner.
# Regenerate locally when needed; see docs on QR provisioning.
provisioning/
