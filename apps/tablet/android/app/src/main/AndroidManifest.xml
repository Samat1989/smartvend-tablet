<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature
        android:name="android.hardware.usb.host"/>
    <uses-permission
        android:name="android.permission.INTERNET"/>
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Keep the screen on for the duration of vending activity. -->
    <uses-permission
        android:name="android.permission.WAKE_LOCK"/>
    <!-- Auto-launch the app after a power-on. -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- In-app self-update via PackageInstaller. Device-owner devices
         install silently; non-owners get a one-time user confirmation. -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- The reason BootReceiver's startActivity is allowed to run at all.
         Android 10+ refuses background activity starts, but exempts callers
         holding SYSTEM_ALERT_WINDOW — and because this permission carries
         the `appop` protection flag it is granted at install time, with the
         app-op left at MODE_DEFAULT. hasSystemAlertWindowPermission() notes
         the op, sees MODE_DEFAULT and falls back to the install grant, so
         the exemption applies without anyone ticking "Display over other
         apps". Confirmed on a factory tablet, which autostarts by this exact
         route and logs:

           W/ActivityTaskManager: Background activity start for
             com.shengma.shouhj.sy.world allowed because
             SYSTEM_ALERT_WINDOW permission is granted.

         Android 14 narrowed this exemption, so on newer tablets the boot
         start needs the device-owner HOME binding instead — see the note in
         MainActivity.configureDeviceOwnerKiosk.

         Only the permission is wanted here, never the app-op: nothing asks
         the operator to tick "Display over other apps", and the app draws no
         overlay of its own. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>

    <application
        android:label="MicroVend"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:excludeFromRecents="true"
            android:resizeableActivity="false"
            android:showOnLockScreen="true"
            android:turnScreenOn="true">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- No CATEGORY_HOME on purpose. The factory app is not a
                 launcher either: the stock launcher3 comes up at boot and
                 the vending app covers it a few seconds later, started by
                 its BOOT_COMPLETED receiver. Matching that leaves a way
                 back into Android on a tablet whose kiosk refuses to start,
                 which is the difference between a phone call and a site
                 visit. Restoring the filter also means restoring
                 addPersistentPreferredActivity in MainActivity — one is
                 useless without the other. -->
            <!-- Auto-launch the app when the M109E's CH340 USB-Serial
                 adapter is plugged in. The exact VID/PID is in
                 res/xml/device_filter.xml (matches the factory app's
                 UsbUtil.findUSB which filters on 0x1A86 / 0x7523). -->
            <intent-filter>
                <action
                    android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"/>
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter"/>
        </activity>
        <!-- Device-admin receiver. Required so the package can be made
             device owner via `adb shell dpm set-device-owner
             kz.smartvend.m102_tester/.KioskAdminReceiver`. Once device
             owner is granted, MainActivity calls setLockTaskPackages
             + setLockTaskFeatures to silently pin the app with no
             system UI. -->
        <receiver
            android:name=".KioskAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin"/>
            <intent-filter>
                <action
                    android:name="android.app.action.DEVICE_ADMIN_ENABLED"/>
            </intent-filter>
        </receiver>
        <!-- Android 11+ provisioning hand-shake. ManagedProvisioning asks
             the DPC which mode to provision and, afterwards, whether it
             still needs anything from the operator. A DPC targeting API 30
             or higher that cannot answer fails QR provisioning outright,
             right after the code is scanned. Both are BIND_DEVICE_ADMIN so
             only the system can start them. See ProvisioningActivities.kt. -->
        <activity
            android:name=".ProvisioningModeActivity"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.NoDisplay"
            android:exported="true">
            <intent-filter>
                <action
                    android:name="android.app.action.GET_PROVISIONING_MODE"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <activity
            android:name=".PolicyComplianceActivity"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.NoDisplay"
            android:exported="true">
            <intent-filter>
                <action
                    android:name="android.app.action.ADMIN_POLICY_COMPLIANCE"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <!-- Auto-relaunch on device boot (power restore). -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action
                    android:name="android.intent.action.BOOT_COMPLETED"/>
                <action
                    android:name="android.intent.action.LOCKED_BOOT_COMPLETED"/>
                <action
                    android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <category
                    android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </receiver>
        <!-- PackageInstaller session-status broadcasts land here. -->
        <receiver
            android:name=".InstallReceiver"
            android:exported="false"/>
        <!-- Exposes the downloaded update APK to the system installer
             (ACTION_VIEW content:// URI) for the manual-install path. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/apk_provider_paths"/>
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action
                android:name="android.intent.action.PROCESS_TEXT"/>
            <data
                android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>